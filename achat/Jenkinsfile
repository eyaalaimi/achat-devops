pipeline {
    agent any
    
    stages {
        stage('📦 Checkout SCM ') {
            steps {
                echo 'Récupération du code depuis GitHub...'
                checkout scm
                echo '✅ Code récupéré'
            }
        }
        
        stage('🔨 Clean & Compile') {
            steps {
                echo 'Compilation du projet...'
                dir('achat') {
                    sh 'mvn clean compile'
                }
            }
        }
        
        stage('🧪 Unit Tests') {
            steps {
                dir('achat') {
                    sh 'mvn test'
                }
            }
        }
        
        stage('📊 SonarQube Analysis') {
            steps {
                dir('achat') {
                    withSonarQubeEnv('SonarServer') {
                        sh 'mvn sonar:sonar -Dsonar.login=squ_330e761a66e39ec648b2e9a0b815f9f6dfdcf25a'
                    }
                }
            }
        }
        
        stage('📦 Package Application') {
            steps {
                dir('achat') {
                    sh 'mvn package -DskipTests'
                }
            }
        }
        
        stage('🐳 Docker Build') {
            steps {
                dir('achat') {
                    echo 'Docker build - will be added later'
                }
            }
        }
        
        stage('📤 Publish to Nexus') {
            steps {
                dir('achat') {
                    echo 'Nexus publish - will be configured later'
                }
            }
        }
    }
    
    post {
        always {
            echo "Pipeline exécuté le : ${new Date()}"
        }
        failure {
            echo '❌ PIPELINE ÉCHOUÉ ❌'
            echo 'Vérifiez les logs ci-dessus'
        }
        success {
            echo '✅ PIPELINE RÉUSSI ✅'
        }
    }
}
