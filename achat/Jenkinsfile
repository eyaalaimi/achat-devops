pipeline {
    agent any
    
    options {
        // Valid options only
        buildDiscarder(logRotator(numToKeepStr: '10', artifactNumToKeepStr: '5'))
        disableConcurrentBuilds()
        timeout(time: 30, unit: 'MINUTES')
        timestamps()
    }
    
    environment {
        MAVEN_HOME = tool 'Maven-3.8.8'  // Configure in Jenkins Global Tools
        JAVA_HOME = tool 'JDK-11'
        MAVEN_OPTS = '-Dmaven.wagon.httpconnectionManager.ttlSeconds=120'
    }
    
    stages {
        stage('📦 Checkout SCM') {
            steps {
                echo 'Récupération du code depuis GitHub...'
                checkout scm
                echo '✅ Code récupéré'
            }
        }
        
        stage('🔨 Clean & Compile') {
            steps {
                echo 'Nettoyage et compilation du projet...'
                
                // Clean workspace manually
                script {
                    // Remove any existing target directories
                    sh 'find . -name "target" -type d -exec rm -rf {} + 2>/dev/null || true'
                    sh 'pkill -f "mvn" || true'
                    sh 'pkill -f "java.*achat" || true'
                }
                
                dir('achat') {
                    // Force clean and compile with retry
                    script {
                        retry(2) {
                            sh '''
                                rm -rf target || true
                                mvn clean compile -DskipTests -Dmaven.clean.failOnError=false
                            '''
                        }
                    }
                }
                echo '✅ Compilation réussie'
            }
        }
        
        stage('🧪 Unit Tests') {
            steps {
                echo 'Exécution des tests unitaires...'
                dir('achat') {
                    sh 'mvn test -Dmaven.test.failure.ignore=false'
                }
                echo '✅ Tests réussis'
            }
            post {
                always {
                    junit 'achat/target/surefire-reports/*.xml'
                }
            }
        }
        
        stage('📊 SonarQube Analysis') {
            when {
                expression { env.BRANCH_NAME == 'main' || env.BRANCH_NAME == 'develop' }
            }
            steps {
                echo 'Analyse SonarQube...'
                dir('achat') {
                    withSonarQubeEnv('SonarQube') {
                        sh 'mvn sonar:sonar'
                    }
                }
            }
        }
        
        stage('📦 Package Application') {
            steps {
                echo 'Packaging de l\'application...'
                dir('achat') {
                    sh 'mvn package -DskipTests'
                }
                echo '✅ Package créé'
            }
            post {
                success {
                    archiveArtifacts artifacts: 'achat/target/*.jar', fingerprint: true
                }
            }
        }
        
        stage('🐳 Docker Build') {
            when {
                expression { env.BRANCH_NAME == 'main' }
            }
            steps {
                echo 'Construction de l\'image Docker...'
                dir('achat') {
                    script {
                        def appVersion = sh(script: 'mvn help:evaluate -Dexpression=project.version -q -DforceStdout', returnStdout: true).trim()
                        sh """
                            docker build -t achat-app:${appVersion} .
                            docker tag achat-app:${appVersion} achat-app:latest
                        """
                    }
                }
            }
        }
        
        stage('📤 Publish to Nexus') {
            when {
                expression { env.BRANCH_NAME == 'main' }
            }
            steps {
                echo 'Publication sur Nexus...'
                dir('achat') {
                    sh 'mvn deploy -DskipTests'
                }
                echo '✅ Publié sur Nexus'
            }
        }
    }
    
    post {
        // Clean workspace in post section (not options)
        always {
            echo "Pipeline exécuté le : ${new Date()}"
            
            // Clean workspace at the end of pipeline
            cleanWs(
                cleanWhenNotBuilt: false,
                deleteDirs: true,
                disableDeferredWipeout: true
            )
        }
        success {
            echo '🎉 PIPELINE RÉUSSI 🎉'
            emailext(
                subject: "Pipeline réussi: ${env.JOB_NAME} - ${env.BUILD_NUMBER}",
                body: "Le pipeline s'est terminé avec succès!\n\nBuild URL: ${env.BUILD_URL}",
                to: 'team@company.com'
            )
        }
        failure {
            echo '❌ PIPELINE ÉCHOUÉ ❌'
            emailext(
                subject: "Pipeline échoué: ${env.JOB_NAME} - ${env.BUILD_NUMBER}",
                body: "Le pipeline a échoué! Veuillez vérifier les logs.\n\nBuild URL: ${env.BUILD_URL}",
                to: 'team@company.com'
            )
        }
        unstable {
            echo '⚠️ PIPELINE INSTABLE ⚠️'
        }
    }
}
