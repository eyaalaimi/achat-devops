pipeline {
    agent any
    
    stages {
        stage('2. Clean & Compile') {
            steps {
                echo 'Nettoyage et compilation du projet...'
                dir('achat') {  // ← Add this line
                    sh 'mvn clean compile'
                }  // ← Add this line
            }
        }
        
        stage('3. Run Unit Tests') {
            steps {
                dir('achat') {  // ← Add this
                    sh 'mvn test'
                }  // ← Add this
            }
        }
        
        stage('4. Package Application') {
            steps {
                dir('achat') {  // ← Add this
                    sh 'mvn package -DskipTests'
                }  // ← Add this
            }
        }
        
        stage('5. SonarQube Analysis') {
            steps {
                dir('achat') {  // ← Add this
                    // Your SonarQube command here
                    sh 'mvn sonar:sonar ...'
                }  // ← Add this
            }
        }
        
        stage('6. Build Docker Image') {
            steps {
                dir('achat') {  // ← Add this
                    // Your Docker build command here
                    sh 'docker build -t achat-app .'
                }  // ← Add this
            }
        }
        
        stage('7. Publish to Nexus') {
            steps {
                dir('achat') {  // ← Add this
                    sh 'mvn deploy'
                }  // ← Add this
            }
        }
    }
    
    post {
        failure {
            echo '❌ PIPELINE ÉCHOUÉ ❌'
        }
        success {
            echo '✅ PIPELINE RÉUSSI ✅'
        }
    }
}
