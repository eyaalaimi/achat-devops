pipeline {
    agent any
    
    environment {
        SONAR_HOST_URL = 'http://172.10.0.140:9000'
    }
    
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        
        stage('Compile') {
            steps {
                dir('achat') {
                    sh 'mvn clean compile'
                }
            }
        }
        
        stage('SonarQube Analysis') {
            steps {
                dir('achat') {
                    script {
                        // Check if credential exists
                        try {
                            withCredentials([string(credentialsId: 'sonar-token', variable: 'SONAR_TOKEN')]) {
                                sh '''
                                    mvn sonar:sonar \
                                        -Dsonar.projectKey=AchatDevOps \
                                        -Dsonar.projectName="AchatDevOps" \
                                        -Dsonar.host.url=${SONAR_HOST_URL} \
                                        -Dsonar.login=${SONAR_TOKEN} \
                                        -Dsonar.java.binaries=target/classes
                                '''
                            }
                        } catch (err) {
                            error "SonarQube token not found. Please add credential 'sonar-token' in Jenkins."
                        }
                    }
                }
            }
        }
        
        stage('Package') {
            steps {
                dir('achat') {
                    sh 'mvn package -DskipTests'
                }
            }
            post {
                success {
                    archiveArtifacts artifacts: 'achat/target/*.jar', allowEmptyArchive: true
                }
            }
        }
    }
    
    post {
        always {
            cleanWs()
        }
        success {
            echo '✅ Pipeline completed successfully!'
        }
        failure {
            echo '❌ Pipeline failed!'
        }
    }
}
