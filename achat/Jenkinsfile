pipeline {
    agent any
    
    stages {
        stage('📦 Checkout SCM') {
            steps {
                echo 'Récupération du code depuis GitHub...'
                checkout scm
                echo '✅ Code récupéré'
            }
        }
        
        stage('🔨 Clean & Compile') {
            steps {
                echo 'Compilation du projet...'
                dir('achat') {
                    sh 'mvn clean compile'
                }
            }
        }
        
        stage('🧪 Unit Tests') {
            steps {
                dir('achat') {
                    sh 'mvn test'
                }
            }
        }
        
        stage('📊 SonarQube Analysis') {
            steps {
                dir('achat') {
                    withSonarQubeEnv('SonarQube') {
                        sh 'mvn sonar:sonar'
                    }
                }
            }
        }
        
        stage('📦 Package Application') {
            steps {
                dir('achat') {
                    sh 'mvn package -DskipTests'
                }
            }
        }
        
        stage('🐳 Docker Build') {
            steps {
                dir('achat') {
                    sh 'docker build -t achat-app:latest .'
                }
            }
        }
        
        stage('📤 Publish to Nexus') {
            steps {
                dir('achat') {
                    sh 'mvn deploy'
                }
            }
        }
    }
    
    post {
        always {
            echo "Pipeline exécuté le : ${new Date()}"
        }
        failure {
            echo '❌ PIPELINE ÉCHOUÉ ❌'
        }
        success {
            echo '✅ PIPELINE RÉUSSI ✅'
        }
    }
}
