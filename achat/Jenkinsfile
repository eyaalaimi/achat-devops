pipeline {
    agent any
    
    tools {
        maven 'maven3'
        jdk 'jdk21'
    }
    
    environment {
        APP_NAME = 'achat'
        VERSION = '1.0.0'
        SONAR_HOST = 'http://<your-vm-ip>:9000'
        SONAR_TOKEN = 'your-sonar-token-here'  // Replace with actual token
        NEXUS_URL = 'http://<your-vm-ip>:8081/repository/maven-releases/'
    }
    
    stages {
        stage('📦 Checkout SCM') {
            steps {
                echo 'Récupération du code depuis GitHub...'
                checkout scm
                echo '✅ Code récupéré'
            }
        }
        
        stage('🔨 Clean & Compile') {
            steps {
                echo 'Compilation du projet...'
                sh 'mvn clean compile'
                echo '✅ Compilation réussie'
            }
        }
        
        stage('🧪 Unit Tests') {
            steps {
                echo 'Exécution des tests unitaires...'
                sh 'mvn test'
                echo '✅ Tests exécutés'
            }
            post {
                always {
                    junit 'target/surefire-reports/*.xml'
                }
            }
        }
        
        stage('📊 SonarQube Analysis') {
            steps {
                echo 'Analyse de qualité du code avec SonarQube...'
                sh '''
                    mvn sonar:sonar \
                        -Dsonar.host.url=${SONAR_HOST} \
                        -Dsonar.login=${SONAR_TOKEN} \
                        -Dsonar.java.binaries=target/classes
                '''
                echo '✅ Analyse SonarQube terminée'
                echo '📈 Voir les résultats: ' + SONAR_HOST
            }
        }
        
        stage('📦 Package Application') {
            steps {
                echo 'Création du package JAR...'
                sh 'mvn package -DskipTests'
                echo '✅ Package créé: target/*.jar'
                archiveArtifacts artifacts: 'target/*.jar', fingerprint: true
            }
        }
        
        stage('🐳 Docker Build') {
            steps {
                echo 'Construction de l\'image Docker...'
                script {
                    docker.build("${APP_NAME}:${BUILD_NUMBER}")
                }
                echo '✅ Image Docker construite'
            }
        }
        
        stage('📤 Publish to Nexus') {
            steps {
                echo 'Publication de l\'artéfact dans Nexus...'
                sh 'mvn deploy -DskipTests'
                echo '✅ Artéfact publié dans Nexus'
                echo '📦 Voir: ' + NEXUS_URL
            }
        }
    }
    
    post {
        success {
            echo '🎉 PIPELINE RÉUSSI ! 🎉'
            echo 'Build #' + currentBuild.number
            echo '📊 SonarQube: ' + SONAR_HOST
            echo '📦 Nexus: ' + NEXUS_URL
        }
        failure {
            echo '❌ PIPELINE ÉCHOUÉ ❌'
            echo 'Vérifiez les logs ci-dessus'
        }
        always {
            echo 'Pipeline exécuté le : ' + new Date()
        }
    }
}
