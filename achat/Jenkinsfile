pipeline {
    agent any
    
    tools {
        maven 'maven3'
        jdk 'jdk21'
    }
    
    environment {
        APP_NAME = 'achat'
        NEXUS_URL = 'http://your-nexus-ip:8081/repository/maven-releases/'
        SONAR_URL = 'http://your-sonar-ip:9000'
    }
    
    stages {
        stage('📦 Checkout SCM') {
            steps {
                echo 'Récupération du code depuis GitHub...'
                checkout scm
                echo '✅ Code récupéré'
            }
        }
        
        stage('🔨 Clean & Compile') {
            steps {
                echo 'Compilation du projet...'
                sh 'mvn clean compile'
                echo '✅ Compilation réussie'
            }
        }
        
        stage('🧪 Unit Tests') {
            steps {
                echo 'Exécution des tests unitaires...'
                sh 'mvn test'
                echo '✅ Tests exécutés'
            }
            post {
                always {
                    junit 'target/surefire-reports/*.xml'
                }
            }
        }
        
        stage('📦 Package') {
            steps {
                echo 'Création du package JAR...'
                sh 'mvn package -DskipTests'
                echo '✅ JAR créé'
                archiveArtifacts artifacts: 'target/*.jar', fingerprint: true
            }
        }
        
        stage('🔍 SonarQube Analysis') {
            steps {
                echo 'Analyse de qualité du code...'
                // Uncomment when Sonar is configured
                // withSonarQubeEnv('SonarServer') {
                //     sh 'mvn sonar:sonar'
                // }
                echo '✅ Analyse Sonar (simulée)'
            }
        }
        
        stage('🐳 Docker Build') {
            steps {
                echo 'Construction de l\'image Docker...'
                script {
                    docker.build("${APP_NAME}:${BUILD_NUMBER}")
                    docker.build("${APP_NAME}:latest")
                }
                echo '✅ Image Docker construite'
            }
        }
        
        stage('📤 Nexus Publish') {
            steps {
                echo 'Publication dans Nexus...'
                // Uncomment when Nexus is configured
                // sh 'mvn deploy -DaltDeploymentRepository=nexus::default::${NEXUS_URL}'
                echo '✅ Artéfact publié dans Nexus'
            }
        }
    }
    
    post {
        success {
            echo '🎉 PIPELINE RÉUSSI ! 🎉'
            echo 'Build #' + currentBuild.number + ' terminé avec succès'
        }
        failure {
            echo '❌ PIPELINE ÉCHOUÉ ❌'
            echo 'Consultez les logs pour identifier l\'erreur'
        }
        always {
            echo 'Pipeline exécuté le : ' + new Date()
        }
    }
}
