pipeline {
    agent any
    
    tools {
        maven 'Maven-3'  // Make sure this matches your Maven installation name in Jenkins
        jdk 'JDK-21'     // Make sure this matches your JDK installation name in Jenkins
    }
    
    stages {
        stage('📦 Checkout SCM') {
            steps {
                echo 'Récupération du code depuis GitHub...'
                checkout scm
                echo '✅ Code récupéré'
            }
        }
        
        stage('🔨 Clean & Compile') {
            steps {
                echo 'Compilation du projet...'
                dir('achat') {  // ← ADD THIS
                    sh 'mvn clean compile'
                }  // ← ADD THIS
            }
        }
        
        stage('🧪 Unit Tests') {
            steps {
                dir('achat') {  // ← ADD THIS
                    sh 'mvn test'
                }  // ← ADD THIS
            }
        }
        
        stage('📦 Package') {
            steps {
                dir('achat') {  // ← ADD THIS
                    sh 'mvn package -DskipTests'
                }  // ← ADD THIS
            }
        }
        
        stage('🔍 SonarQube Analysis') {
            steps {
                dir('achat') {  // ← ADD THIS
                    echo 'SonarQube analysis - not configured yet'
                    // sh 'mvn sonar:sonar'
                }  // ← ADD THIS
            }
        }
        
        stage('🐳 Docker Build') {
            steps {
                dir('achat') {  // ← ADD THIS
                    echo 'Docker build - will be added later'
                    // sh 'docker build -t achat-app .'
                }  // ← ADD THIS
            }
        }
        
        stage('📤 Nexus Publish') {
            steps {
                dir('achat') {  // ← ADD THIS
                    echo 'Nexus publish - will be added later'
                    // sh 'mvn deploy'
                }  // ← ADD THIS
            }
        }
    }
    
    post {
        always {
            echo "Pipeline exécuté le : ${new Date()}"
        }
        failure {
            echo '❌ PIPELINE ÉCHOUÉ ❌'
            echo 'Consultez les logs pour identifier l erreur'
        }
        success {
            echo '✅ PIPELINE RÉUSSI ✅'
        }
    }
}
