pipeline {
    agent any
    
    stages {
        stage('2. Clean & Compile') {
            steps {
                echo 'Nettoyage et compilation du projet...'
                dir('achat') {
                    sh 'mvn clean compile'
                }
            }
        }
        
        stage('3. Run Unit Tests') {
            steps {
                dir('achat') {
                    sh 'mvn test'
                }
            }
        }
        
        stage('4. Package Application') {
            steps {
                dir('achat') {
                    sh 'mvn package -DskipTests'
                }
            }
        }
        
        stage('5. SonarQube Analysis') {
            steps {
                dir('achat') {
                    echo 'SonarQube analysis skipped - not configured yet'
                    // sh 'mvn sonar:sonar'
                }
            }
        }
        
        stage('6. Build Docker Image') {
            steps {
                dir('achat') {
                    echo 'Docker build skipped - will be added later'
                    // sh 'docker build -t achat-app .'
                }
            }
        }
        
        stage('7. Publish to Nexus') {
            steps {
                dir('achat') {
                    echo 'Nexus publishing skipped - will be configured later'
                    // sh 'mvn deploy'
                }
            }
        }
    }
    
    post {
        failure {
            echo '❌ PIPELINE ÉCHOUÉ ❌'
            echo 'Vérifiez les logs ci-dessus pour identifier l erreur'
        }
        success {
            echo '✅ PIPELINE RÉUSSI ✅'
        }
    }
}
